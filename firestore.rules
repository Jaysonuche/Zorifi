rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function publicProfile(uid) { return get(/databases/$(database)/documents/socialProfiles/$(uid)).data.discoverable == true; }
    function blocked(a, b) {
      return exists(/databases/$(database)/documents/socialBlocks/$(a)/blocked/$(b)) ||
        exists(/databases/$(database)/documents/socialBlocks/$(b)/blocked/$(a));
    }
    function rateValue(uid, field) {
      return exists(/databases/$(database)/documents/socialRates/$(uid)) ?
        get(/databases/$(database)/documents/socialRates/$(uid)).data.get(field, timestamp.date(1970, 1, 1)) : timestamp.date(1970, 1, 1);
    }
    function ratePath(uid, field) {
      return exists(/databases/$(database)/documents/socialRates/$(uid)) ?
        get(/databases/$(database)/documents/socialRates/$(uid)).data.get(field, '') : '';
    }
    // Each allowance belongs to one exact document, including its parent path.
    // A single rate update must never authorize several creates in one batch.
    function paced(field, pathField, documentPath, seconds) {
      let rate = getAfter(/databases/$(database)/documents/socialRates/$(request.auth.uid)).data;
      return rate[field] == request.time && rate[pathField] == documentPath &&
        rateValue(request.auth.uid, field) <= request.time - duration.value(seconds, 's');
    }
    function connection(id) { return get(/databases/$(database)/documents/socialConnections/$(id)).data; }
    function connectionMember(data) { return signedIn() && request.auth.uid in data.members; }
    function activeConnection(id) {
      let c = connection(id);
      return connectionMember(c) && c.status == 'accepted' && !blocked(c.members[0], c.members[1]);
    }
    match /socialProfiles/{uid} {
      allow get: if signedIn() && (owner(uid) || resource.data.discoverable == true);
      allow list: if signedIn() && request.query.limit <= 50 && resource.data.discoverable == true;
      function validProfile() {
        let d = request.resource.data;
        return owner(uid) && d.keys().hasOnly(['uid', 'name', 'bio', 'craft', 'discoverable', 'createdAt', 'updatedAt', 'username']) &&
          d.keys().hasAll(['uid', 'name', 'bio', 'craft', 'discoverable', 'createdAt', 'updatedAt']) &&
          d.uid == uid && d.name is string && d.name.size() >= 2 && d.name.size() <= 60 &&
          d.bio is string && d.bio.size() <= 300 && d.craft in ['Video', 'Music', 'Photography', 'Motion', 'Mixed media'] &&
          d.discoverable is bool && d.updatedAt == request.time &&
          (!('username' in d) || (d.username is string && d.username.matches('^[a-z][a-z0-9_]{2,23}$') &&
            getAfter(/databases/$(database)/documents/socialUsernames/$(d.username)).data.uid == uid));
      }
      function previousUsernameReleased() {
        return !('username' in resource.data) ||
          (request.resource.data.get('username', '') == resource.data.username) ||
          !existsAfter(/databases/$(database)/documents/socialUsernames/$(resource.data.username));
      }
      allow create: if validProfile() && request.resource.data.createdAt == request.time;
      allow update: if validProfile() && previousUsernameReleased() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner(uid) && (!('username' in resource.data) ||
        !existsAfter(/databases/$(database)/documents/socialUsernames/$(resource.data.username)));
    }
    // A name belongs to exactly one profile. Both sides change atomically.
    match /socialUsernames/{username} {
      allow get: if signedIn() && (owner(resource.data.uid) || publicProfile(resource.data.uid));
      allow list, update: if false;
      allow create: if signedIn() && username.matches('^[a-z][a-z0-9_]{2,23}$') &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.keys().hasAll(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.username == username;
      allow delete: if owner(resource.data.uid) &&
        (!existsAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)) ||
          getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.get('username', '') != username);
    }
    // Only explicitly selected finished videos are published here. These paths
    // never contain Studio projects, editing timelines or imported source files.
    match /socialPosts/{postId} {
      allow get: if signedIn() && (resource.data.status == 'published' || owner(resource.data.uid));
      allow list: if signedIn() && request.query.limit <= 20 &&
        (resource.data.status == 'published' || owner(resource.data.uid));
      function validPost() {
        let d = request.resource.data;
        return owner(d.uid) && postId.matches('^[-_a-zA-Z0-9]{5,100}$') &&
          d.keys().hasOnly(['uid', 'mediaPath', 'caption', 'status', 'bytes', 'mime', 'duration', 'width', 'height', 'createdAt', 'publishedAt']) &&
          d.keys().hasAll(['uid', 'mediaPath', 'caption', 'status', 'bytes', 'mime', 'duration', 'width', 'height', 'createdAt']) &&
          d.mediaPath == 'social-media/' + request.auth.uid + '/' + postId + '/video' &&
          d.caption is string && d.caption.size() <= 1200 && d.bytes is int && d.bytes >= 16 && d.bytes <= 62914560 &&
          d.mime in ['video/mp4', 'video/webm'] && d.duration is number && d.duration > 0 && d.duration <= 180 &&
          d.width is int && d.width >= 1 && d.width <= 7680 && d.height is int && d.height >= 1 && d.height <= 7680;
      }
      allow create: if validPost() && publicProfile(request.auth.uid) &&
        get(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.username is string &&
        request.resource.data.status == 'uploading' && !('publishedAt' in request.resource.data) &&
        request.resource.data.createdAt == request.time && paced('lastPostAt', 'lastPostPath', 'socialPosts/' + postId, 30);
      allow update: if validPost() && owner(resource.data.uid) && publicProfile(request.auth.uid) &&
        resource.data.status == 'uploading' && request.resource.data.status == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedAt']) &&
        request.resource.data.publishedAt == request.time;
      allow delete: if owner(resource.data.uid);
    }
    match /socialRates/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      function validRate(d, field, pathField, seconds) {
        return (!(field in d) && !(pathField in d)) ||
          (field in d && d[field] is timestamp &&
            ((d[field] == rateValue(uid, field) && d.get(pathField, '') == ratePath(uid, pathField)) ||
              (d[field] == request.time && d.get(pathField, '') is string && d.get(pathField, '').size() >= 1 &&
                d.get(pathField, '').size() <= 450 &&
                rateValue(uid, field) <= request.time - duration.value(seconds, 's'))));
      }
      function validRates() {
        let d = request.resource.data;
        return owner(uid) && d.keys().hasOnly(['lastRequestAt', 'lastRequestPath', 'lastMessageAt', 'lastMessagePath', 'lastReportAt', 'lastReportPath', 'lastPostAt', 'lastPostPath']) &&
          d.keys().size() > 0 && validRate(d, 'lastRequestAt', 'lastRequestPath', 10) &&
          validRate(d, 'lastMessageAt', 'lastMessagePath', 1) && validRate(d, 'lastReportAt', 'lastReportPath', 30) &&
          validRate(d, 'lastPostAt', 'lastPostPath', 30);
      }
      allow create: if validRates();
      allow update: if validRates() && request.resource.data.keys().hasAll(resource.data.keys());
    }
    match /socialConnections/{id} {
      allow get: if connectionMember(resource.data);
      allow list: if signedIn() && request.query.limit <= 50 && request.auth.uid in resource.data.members;
      function validConnection() {
        let d = request.resource.data;
        return signedIn() && d.keys().hasOnly(['members', 'requester', 'recipient', 'status', 'createdAt', 'updatedAt']) &&
          d.keys().hasAll(['members', 'requester', 'recipient', 'status', 'createdAt', 'updatedAt']) &&
          d.members is list && d.members.size() == 2 && d.members[0] is string && d.members[1] is string &&
          d.members[0].matches('^[-_a-zA-Z0-9]{1,128}$') && d.members[1].matches('^[-_a-zA-Z0-9]{1,128}$') &&
          d.members[0] != d.members[1] && id == d.members[0] + '~' + d.members[1] &&
          d.requester is string && d.recipient is string && d.requester != d.recipient &&
          d.members.hasAll([d.requester, d.recipient]) && d.updatedAt == request.time;
      }
      allow create: if validConnection() && request.resource.data.requester == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        publicProfile(request.resource.data.requester) && publicProfile(request.resource.data.recipient) &&
        !blocked(request.resource.data.requester, request.resource.data.recipient) &&
        !exists(/databases/$(database)/documents/socialConnections/$(request.resource.data.members[1] + '~' + request.resource.data.members[0])) &&
        !existsAfter(/databases/$(database)/documents/socialConnections/$(request.resource.data.members[1] + '~' + request.resource.data.members[0])) &&
        paced('lastRequestAt', 'lastRequestPath', 'socialConnections/' + id, 10);
      allow update: if validConnection() && connectionMember(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        resource.data.status == 'pending' &&
        ((request.auth.uid == resource.data.recipient && request.resource.data.status in ['accepted', 'declined'] &&
          !blocked(resource.data.requester, resource.data.recipient)) ||
          (request.auth.uid == resource.data.requester && request.resource.data.status == 'cancelled'));
      allow delete: if false;
      match /messages/{messageId} {
        allow get: if activeConnection(id);
        allow list: if activeConnection(id) && request.query.limit <= 100;
        allow create: if activeConnection(id) &&
          request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt']) &&
          request.resource.data.keys().hasAll(['sender', 'text', 'createdAt']) &&
          request.resource.data.sender == request.auth.uid && request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          paced('lastMessageAt', 'lastMessagePath', 'socialConnections/' + id + '/messages/' + messageId, 1);
        allow update, delete: if false;
      }
    }
    match /socialBlocks/{uid}/blocked/{otherUid} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && uid != otherUid &&
        request.resource.data.keys().hasOnly(['owner', 'blockedUid', 'createdAt']) &&
        request.resource.data.owner == uid && request.resource.data.blockedUid == otherUid &&
        request.resource.data.createdAt == request.time;
      allow delete: if owner(uid);
      allow update: if false;
    }
    match /socialReports/{id} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['reporter', 'targetUid', 'reason', 'connectionId', 'createdAt']) &&
        request.resource.data.keys().hasAll(['reporter', 'targetUid', 'reason', 'connectionId', 'createdAt']) &&
        request.resource.data.reporter == request.auth.uid && request.resource.data.targetUid is string &&
        request.resource.data.targetUid != request.auth.uid && request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 1000 &&
        request.resource.data.connectionId is string && request.resource.data.connectionId.size() <= 260 &&
        request.resource.data.createdAt == request.time && paced('lastReportAt', 'lastReportPath', 'socialReports/' + id, 30);
      allow get: if signedIn() && resource.data.reporter == request.auth.uid;
      allow list, update, delete: if false;
    }
    // Private Vanessa sessions contain chat turns and project IDs, never Studio files.
    match /users/{uid}/vanessaLimits/chat {
      allow get: if owner(uid);
      allow list, delete: if false;
      function validLimit() {
        let d = request.resource.data;
        return owner(uid) && d.keys().hasOnly(['uid','count','startedAt','updatedAt']) &&
          d.uid == uid && d.count is int && d.count >= 1 && d.count <= 20 &&
          d.startedAt is timestamp && d.updatedAt == request.time;
      }
      allow create: if validLimit() && request.resource.data.count == 1 && request.resource.data.startedAt == request.time;
      allow update: if validLimit() &&
        ((request.resource.data.startedAt == resource.data.startedAt && request.resource.data.count == resource.data.count + 1 && request.time < resource.data.startedAt + duration.value(60,'s')) ||
         (resource.data.startedAt <= request.time - duration.value(60,'s') && request.resource.data.startedAt == request.time && request.resource.data.count == 1));
    }
    match /users/{uid}/sessions/{sessionId} {
      allow get, delete: if owner(uid);
      allow list: if false;
      function validSession() {
        let d = request.resource.data;
        return owner(uid) && sessionId.matches('^[a-zA-Z0-9_-]{1,160}$') &&
          d.keys().hasOnly(['uid','projectId','sequence','requestId','status','historyJson','resultJson','requestHash','resultSignature','startedAt','updatedAt']) &&
          d.uid == uid && d.projectId is string && d.projectId.size() <= 160 &&
          d.sequence is int && d.sequence > 0 && d.requestId is string && d.requestId.size() <= 160 &&
          d.status in ['pending','complete','cancelled','failed'] && d.startedAt is timestamp &&
          d.updatedAt == request.time && d.historyJson is string && d.historyJson.size() <= 100000 &&
          d.resultJson is string && d.resultJson.size() <= 32000 &&
          d.requestHash is string && d.requestHash.matches('^[a-f0-9]{64}$') &&
          d.resultSignature is string && (d.resultSignature == '' || d.resultSignature.matches('^[a-f0-9]{64}$'));
      }
      allow create: if validSession() && request.resource.data.sequence == 1 &&
        request.resource.data.status == 'pending' && request.resource.data.startedAt == request.time &&
        request.resource.data.historyJson == '[]' && request.resource.data.resultJson == '' && request.resource.data.resultSignature == '';
      allow update: if validSession() && request.resource.data.projectId == resource.data.projectId &&
        ((resource.data.status == 'pending' && request.resource.data.sequence == resource.data.sequence &&
          request.resource.data.requestId == resource.data.requestId && request.resource.data.startedAt == resource.data.startedAt &&
          request.resource.data.requestHash == resource.data.requestHash &&
          request.resource.data.status in ['complete','cancelled','failed']) ||
         (request.resource.data.sequence == resource.data.sequence + 1 && request.resource.data.requestId != resource.data.requestId &&
          request.resource.data.status == 'pending' && request.resource.data.startedAt == request.time &&
          request.resource.data.historyJson == resource.data.historyJson && request.resource.data.resultJson == '' && request.resource.data.resultSignature == '' &&
          (resource.data.status != 'pending' || resource.data.startedAt < request.time - duration.value(130,'s'))));
    }
    // Optional categorical creative outcomes. No assets, text or preferences.
    // The collector signs receipts; offline evaluation rejects forged receipts.
    match /users/{uid}/private/creativeLearning {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(['uid','sharedFeedback','updatedAt']) &&
        request.resource.data.keys().hasAll(['uid','sharedFeedback','updatedAt']) &&
        request.resource.data.uid == uid && request.resource.data.sharedFeedback is bool &&
        request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/creativeFeedback/{eventId} {
      allow get, list, delete: if owner(uid);
      allow update: if false;
      allow create: if owner(uid) &&
        eventId.matches('^([a-fA-F0-9-]{36}|event-[a-zA-Z0-9-]{6,80})$') &&
        request.resource.data.keys().hasOnly(['id','schema','strategy','style','outcome','issue','quality','duration','turns','elapsed','uid','signature','createdAt']) &&
        request.resource.data.keys().hasAll(['id','schema','strategy','style','outcome','issue','quality','duration','turns','elapsed','uid','signature','createdAt']) &&
        request.resource.data.id == eventId && request.resource.data.uid == uid &&
        request.resource.data.schema == 'zorifi.creative-learning/1' &&
        request.resource.data.strategy in ['baseline-v1','cinematic-v1','fashion-v1','social-v1','documentary-v1','interview-v1','corporate-v1','music-video-v1'] &&
        request.resource.data.style in ['general','cinematic','fashion','social','documentary','interview','corporate','music-video'] &&
        request.resource.data.outcome in ['succeeded','failed','accepted','rejected','corrected','undone'] &&
        request.resource.data.issue in ['none','pacing','transition','effect','colour','audio-sync','audio-level','text','caption','media','gap','duration','aspect','story','other'] &&
        request.resource.data.quality in ['pass','fail','partial','unknown'] &&
        request.resource.data.duration in ['unknown','0-15s','15-30s','30-60s','1-3m','3m+'] &&
        request.resource.data.turns in ['unknown','0-1','2-4','5+'] &&
        request.resource.data.elapsed in ['unknown','0-30s','30-120s','2-10m','10m+'] &&
        request.resource.data.signature is string && request.resource.data.signature.matches('^[a-f0-9]{64}$') &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/users/$(uid)/private/creativeLearning).data.sharedFeedback == true;
    }
    // Existing billing records remain owner-readable and server-written only.
    match /users/{uid}/private/subscription { allow get: if owner(uid); allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
