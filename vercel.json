{
  "buildCommand": "node scripts/build-web.cjs",
  "outputDirectory": "web-dist",
  "functions": {
    "api/vanessa-provider.js": {
      "includeFiles": "{netlify/functions/**,zorifi-vanessa-identity.js,zorifi-interface-language.js,zorifi-interface-catalog.json,zorifi-phase10.js,zorifi-tool-registry.js,zorifi-sfx.js,zorifi-background-cutout.js}",
      "maxDuration": 120
    },
    "api/ai-settings.js": {
      "includeFiles": "{netlify/functions/**,zorifi-vanessa-identity.js,zorifi-tool-registry.js,zorifi-sfx.js,zorifi-background-cutout.js}"
    },
    "api/vanessa/chat.js": {
      "includeFiles": "{netlify/functions/**,zorifi-vanessa-identity.js,zorifi-interface-language.js,zorifi-interface-catalog.json,zorifi-phase10.js,zorifi-tool-registry.js,zorifi-sfx.js,zorifi-background-cutout.js}",
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/.netlify/functions/([a-z-]+)",
      "dest": "/api/vanessa-provider?service=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
