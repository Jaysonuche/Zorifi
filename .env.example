# Server-side credentials. Never put real secrets into browser source or commit them.
# Optional OpenRouter text/planning provider; takes precedence when the key is set.
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=openrouter/free
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_LANGUAGE_API_KEY=
OPENAI_IMAGE_API_KEY=
VANESSA_MODEL=gpt-5-nano
VANESSA_IMAGE_MODEL=gpt-image-2
XAI_API_KEY=
VANESSA_VIDEO_MODEL=grok-imagine-video-1.5
ELEVENLABS_API_KEY=
VANESSA_VOICE_ID=
VANESSA_VOICE_MODEL=eleven_multilingual_v2
VANESSA_MUSIC_URL=
VANESSA_MUSIC_KEY=
VANESSA_MUSIC_MODEL=
VANESSA_STEMS_URL=
VANESSA_STEMS_KEY=
VANESSA_GPU_URL=
VANESSA_GPU_KEY=
VANESSA_GPU_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# Public Firebase web configuration, injected only by build:web.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Public Google OAuth web client ID. Never put a client secret in browser config.
GOOGLE_OAUTH_CLIENT_ID=
FIREBASE_STORAGE_BUCKET=
# Enable only after Firebase Storage is provisioned and storage.rules deployed.
ZORIFI_SOCIAL_MEDIA_ENABLED=false
# Comma-separated additional hosted browser origins, if required.
ZORIFI_ALLOWED_ORIGINS=
GMAIL_ACCESS_TOKEN=
ZORIFI_SUPPORT_EMAIL=
ZORIFI_SUPPORT_SENDER=

# Local customer dashboard only: use a random key of at least 32 characters.
CRM_ADMIN_KEY=

# Google AI Studio: server-only credential for Vanessa chat, Gemini image creation and Lyria music.
# Gemini image and music generation have no API free tier; configure billing before use.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# Hosted paid media generation is limited to these verified Firebase UIDs.
ZORIFI_ADMIN_UIDS=

# Server-only Replicate token. Enables Wan 2.1 1.3B short video generation.
REPLICATE_API_TOKEN=

# Optional: return a local Wan execution payload instead of starting a cloud render
VANESSA_VIDEO_EXECUTION_MODE=auto

# Force the structured local video handoff (does not launch a GPU runner)
ZORIFI_LOCAL_VIDEO_FALLBACK=false

# Optional stable server-only key for signed Vanessa conversation replies.
# If empty, the configured text-provider key is used with domain separation.
# Rotating either key invalidates old reply replays; start a new chat afterward.
VANESSA_SESSION_SIGNING_KEY=

# Vanessa OpenAI backend. Enter real credentials only via a secret/environment
# manager or the hidden local PowerShell launcher; never paste them into source.
OPENAI_API_KEY=
VANESSA_LANGUAGE_PROVIDER=auto
OPENAI_RESPONSES_MODEL=gpt-5-nano
OPENAI_STATE_BACKEND=firestore
# Recommended stable server-only signing secret; fallback uses the API key.
# Preserve this across key rotations or existing signed state will fail closed.
OPENAI_STATE_SIGNING_KEY=
OPENAI_REQUESTS_PER_MINUTE=20
OPENAI_DAILY_TOKEN_LIMIT=50000
# Optional stateful-local alternative. Absolute private SQLite file path only.
OPENAI_STATE_PATH=
# Optional capabilities require BOTH a flag and exact authenticated UID allowlist.
OPENAI_ALLOWED_MEDIA_UIDS=
OPENAI_ENABLE_VOICE=false
OPENAI_ENABLE_REALTIME=false
OPENAI_ENABLE_IMAGES=false
OPENAI_ENABLE_VIDEO=false
OPENAI_ENABLE_FILES=false
OPENAI_ENABLE_RETRIEVAL=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2
# Development only: local demo project + loopback endpoints, rejected on hosts.
ZORIFI_FIREBASE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Production rollout gates. Keep off until the reviewed preview is approved.
OPENAI_HOSTED_ENABLED=false
OPENAI_ALLOWED_USER_UIDS=
OPENAI_MAX_CONCURRENT_REQUESTS=1
OPENAI_MAX_REQUESTS_PER_DAY=100
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_DAILY_VOICE_LIMIT=1
OPENAI_DAILY_IMAGE_LIMIT=1
OPENAI_DAILY_VIDEO_LIMIT=1
OPENAI_DAILY_REALTIME_LIMIT=1
OPENAI_DAILY_FILE_LIMIT=1
OPENAI_DAILY_VECTOR_LIMIT=1
# Backend verification is available; configure/test the attestation client before
# enabling enforcement. Hosted Realtime stays blocked regardless of its flag.
OPENAI_REQUIRE_APP_CHECK=false
FIREBASE_PROJECT_NUMBER=
