# Server-side credentials. Never put real secrets into browser source or commit them.
# Optional OpenRouter text/planning provider; takes precedence when the key is set.
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=openrouter/free
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_LANGUAGE_API_KEY=
OPENAI_IMAGE_API_KEY=
VANESSA_MODEL=gpt-5-nano
VANESSA_IMAGE_MODEL=gpt-image-2
XAI_API_KEY=
VANESSA_VIDEO_MODEL=grok-imagine-video-1.5
ELEVENLABS_API_KEY=
VANESSA_VOICE_ID=
VANESSA_VOICE_MODEL=eleven_multilingual_v2
VANESSA_MUSIC_URL=
VANESSA_MUSIC_KEY=
VANESSA_MUSIC_MODEL=
VANESSA_STEMS_URL=
VANESSA_STEMS_KEY=
VANESSA_GPU_URL=
VANESSA_GPU_KEY=
VANESSA_GPU_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# Public Firebase web configuration, injected only by build:web.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Public Google OAuth web client ID. Never put a client secret in browser config.
GOOGLE_OAUTH_CLIENT_ID=
FIREBASE_STORAGE_BUCKET=
# Enable only after Firebase Storage is provisioned and storage.rules deployed.
ZORIFI_SOCIAL_MEDIA_ENABLED=false
# Comma-separated additional hosted browser origins, if required.
ZORIFI_ALLOWED_ORIGINS=
GMAIL_ACCESS_TOKEN=
ZORIFI_SUPPORT_EMAIL=
ZORIFI_SUPPORT_SENDER=

# Local customer dashboard only: use a random key of at least 32 characters.
CRM_ADMIN_KEY=

# Google AI Studio: server-only credential for Vanessa chat, Gemini image creation and Lyria music.
# Gemini image and music generation have no API free tier; configure billing before use.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# Hosted paid media generation is limited to these verified Firebase UIDs.
ZORIFI_ADMIN_UIDS=

# Server-only Replicate token. Enables Wan 2.1 1.3B short video generation.
REPLICATE_API_TOKEN=

# Optional: return a local Wan execution payload instead of starting a cloud render
VANESSA_VIDEO_EXECUTION_MODE=auto

# Force the structured local video handoff (does not launch a GPU runner)
ZORIFI_LOCAL_VIDEO_FALLBACK=false

# Optional stable server-only key for signed Vanessa conversation replies.
# If empty, the configured text-provider key is used with domain separation.
# Rotating either key invalidates old reply replays; start a new chat afterward.
VANESSA_SESSION_SIGNING_KEY=
