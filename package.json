{
  "name": "zorifi-video-editor",
  "version": "3.39.3",
  "packageManager": "pnpm@11.25.0",
  "description": "Zorifi cross-platform video editor",
  "desktopName": "Zorifi",
  "homepage": "https://zorifi.vercel.app",
  "main": "electron-main.cjs",
  "author": "J.U.P.C.O Enterprises",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:web": "node scripts/build-web.cjs",
    "android:sync": "node scripts/build-android.cjs sync",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-android.cjs apk",
    "android:bundle": "node scripts/build-android.cjs bundle",
    "start": "electron .",
    "package:windows": "electron-packager . Zorifi --platform=win32 --arch=x64 --out=release --overwrite --icon=build/zorifi.ico --ignore=release --ignore=release-vanessa-local --ignore=Zorifi-video-editor-current.zip --ignore=[.]env --ignore=[.]zorifi-private",
    "package:macos": "electron-builder --mac dmg zip --x64 --arm64",
    "package:linux": "electron-builder --linux AppImage deb --x64",
    "package:linux:portable": "electron-builder --linux AppImage --x64",
    "package:current": "node scripts/package-current.cjs",
    "package:vanessa-local": "electron-packager . Zorifi --platform=win32 --arch=x64 --out=release-vanessa-local --icon=icons/icon-512.png --ignore=release --ignore=release-vanessa-local --ignore=installer-dist --ignore=Zorifi-video-editor-current.zip --ignore=[.]env --ignore=[.]zorifi-private",
    "installer:windows": "electron-builder --win nsis --x64",
    "dev": "node scripts/dev-server.cjs",
    "generate:assets": "node scripts/generate-assets.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "check": "node scripts/check-project.cjs"
  },
  "build": {
    "appId": "com.zorifi.editor",
    "productName": "Zorifi",
    "asar": true,
    "directories": {
      "output": "installer-dist"
    },
    "files": [
      "app.js",
      "zorifi-theme.js",
      "zorifi-support.js",
      "zorifi-beta-program.js",
      "zorifi-terms.js",
      "zorifi-billing.js",
      "zorifi-firebase.js",
      "zorifi-stickers.js",
      "zorifi-vanessa-identity.js",
      "zorifi-vanessa-memory.js",
      "zorifi-vanessa-memory-manager.js",
      "zorifi-vanessa-memory-context.js",
      "zorifi-vanessa-conversation-continuity.js",
      "zorifi-vanessa-personalization.js",
      "zorifi-vanessa-intent.js",
      "zorifi-vanessa-response-planner.js",
      "zorifi-vanessa-workflow.js",
      "zorifi-vanessa-reference-analysis.js",
      "zorifi-vanessa-visual-analysis.js",
      "zorifi-vanessa-reference-execution.js",
      "zorifi-vanessa-style-intelligence.js",
      "zorifi-vanessa-content-matching.js",
      "zorifi-vanessa-edit-planner.js",
      "zorifi-vanessa-execution-feedback.js",
      "zorifi-vanessa-edit-adaptation.js",
      "zorifi-vanessa-task-orchestration.js",
      "zorifi-vanessa-task-continuity.js",
      "zorifi-vanessa-goal-understanding.js",
      "zorifi-vanessa-creative-intent.js",
      "zorifi-vanessa-capability-planner.js",
      "zorifi-vanessa-creative-plan.js",
      "zorifi-vanessa-creative-conversation.js",
      "zorifi-vanessa-creative-verification.js",
      "zorifi-vanessa-creative-pipeline.js",
      "zorifi-vanessa-router.js",
      "zorifi-vanessa-core.js",
      "zorifi-project-model.js",
      "zorifi-advanced-editing.js",
      "zorifi-visual-tools.js",
      "zorifi-motion-effects.js",
      "zorifi-compute-engine.js",
      "zorifi-ai-provider.js",
      "zorifi-ai-platform.js",
      "zorifi-audio-engine.js",
      "zorifi-music-studio.js",
      "zorifi-vanessa-actions.js",
      "zorifi-scenes.js",
      "zorifi-creator-platform.js",
      "zorifi-phase8.js",
      "zorifi-phase9.js",
      "zorifi-phase10.js",
      "zorifi-phase11.js",
      "zorifi-autocut-media.js",
      "zorifi-autocut.js",
      "zorifi-autocut-creative.js",
      "zorifi-autocut-director.js",
      "zorifi-autocut-renderer.js",
      "zorifi-autocut-studio.js",
      "zorifi-editor-overhaul.js",
      "styles.css",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "electron-main.cjs",
      "scripts/local-media-jobs.cjs",
      "scripts/hosted-language-gateway.cjs",
      "zorifi-local-companion.js",
      "assets/**/*",
      "icons/**/*",
      "netlify/functions/**/*",
      "vanessa-gpu/**/*",
      "package.json",
      "zorifi-privacy.js",
      "zorifi-privacy-ui.js",
      "zorifi-optimization.js",
      "zorifi-audio-worker.js",
      "zorifi-multicam.js",
      "zorifi-color-scopes.js",
      "zorifi-master-app.js",
      "ZorifiVanessaStudioCore.js",
      "ZorifiVanessaTrueAudioAI.js",
      "ZorifiAutoCaptions.js",
      "ZorifiMulticamSyncEngine.js",
      "zorifi-tool-registry.js",
      "zorifi-person-cutout.js",
      "zorifi-template-feed.js",
      "zorifi-template-feed.css",
      "zorifi-vanessa-orb.css",
      "zorifi-device-lab.js",
      "zorifi-device-lab.css",
      "zorifi-device-integration.js",
      "zorifi-touch-workspace.css",
      "zorifi-sfx.js",
      "zorifi-editor-workbench.js",
      "zorifi-editor-workbench.css",
      "zorifi-workbench-integration.js",
      "zorifi-vanessa-chat.css",
      "zorifi-music-catalogue.js",
      "zorifi-music-catalogue.css",
      "zorifi-vanessa-listening.js",
      "zorifi-editor-refinements.css",
      "zorifi-background-cutout.js",
      "zorifi-background-cutout.css",
      "zorifi-background-integration.js",
      "zorifi-social.js",
      "zorifi-social.css",
      "zorifi-social-integration.js",
      "zorifi-app-settings.js",
      "zorifi-app-settings.css",
      "zorifi-google-connections.js",
      "zorifi-google-connections.css",
      "zorifi-google-integration.js",
      "zorifi-social-creator.js",
      "zorifi-social-creator.css",
      "zorifi-timeline-interactions.js",
      "zorifi-timeline-interactions.css",
      "zorifi-pocket-editor.js",
      "zorifi-pocket-editor.css",
      "zorifi-editor-future.css",
      "zorifi-music-future.css",
      "zorifi-vanessa-future.css",
      "zorifi-opening.css",
      "zorifi-opening.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/zorifi.ico",
      "artifactName": "Zorifi-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "icons/icon-512.png",
      "artifactName": "Zorifi-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Zorifi uses the microphone only when you choose voice recording, voiceover, or Vanessa voice interaction.",
        "NSCameraUsageDescription": "Zorifi uses the camera only when you choose to record or import from your camera.",
        "NSDocumentsFolderUsageDescription": "Zorifi accesses only media and project files that you select."
      }
    },
    "dmg": {
      "title": "Zorifi ${version}",
      "artifactName": "Zorifi-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;AudioVideoEditing",
      "icon": "icons/icon-512.png",
      "executableName": "zorifi",
      "syncDesktopName": true,
      "synopsis": "AI-powered video creation and editing workspace",
      "description": "Zorifi is a professional video editor with timeline editing, effects, audio, captions, export and the Vanessa creative assistant.",
      "maintainer": "Zorifi Studio <zorifvideoeditor@gmail.com>",
      "vendor": "J.U.P.C.O Enterprises",
      "artifactName": "Zorifi-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "priority": "optional"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zorifi",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@electron/asar": "^3.4.1",
    "@electron/packager": "^18.4.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "playwright": "1.62.1",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.28.0"
  }
}
